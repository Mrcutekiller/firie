# ---------------------------------------------------------------------------
# FITLY environment configuration
# Copy to `.env` and fill in. Every value is optional — the app runs fully
# on-device (local storage, on-device AI heuristics) without any of these.
# ---------------------------------------------------------------------------

# AI — FreeLLMAPI (OpenAI-compatible proxy). Text-only.
#   https://github.com/tashfeenahmed/freellmapi
VITE_FREELLMAPI_URL=http://localhost:3001/v1
VITE_FREELLMAPI_KEY=
VITE_FREELLMAPI_MODEL=auto

# Optional multimodal provider for true photo analysis (if you have one).
VITE_VISION_API_URL=
VITE_VISION_API_KEY=
VITE_VISION_MODEL=gpt-4o-mini

# Cloud backend — Supabase (fill in when the project is connected).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payments — Stripe (Pro plan).
VITE_STRIPE_PUBLISHABLE_KEY=
